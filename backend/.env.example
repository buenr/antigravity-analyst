# Application Settings
APP_NAME=Antigravity Data Analyst
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Google Cloud Settings
GCP_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
# Path to service account JSON (optional if using ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_AGENT_NAME=antigravity-preview-05-2026
# Optional specialist managed agents. Leave blank to fall back to GEMINI_AGENT_NAME.
GEMINI_DATA_PROFILER_AGENT_NAME=data-profiler
GEMINI_STATISTICIAN_AGENT_NAME=statistician
GEMINI_ML_REVIEWER_AGENT_NAME=ml-reviewer
GEMINI_FORECASTING_REVIEWER_AGENT_NAME=forecasting-reviewer
GEMINI_DELIVERABLE_BUILDER_AGENT_NAME=deliverable-builder
GEMINI_SYSTEM_INSTRUCTION=You are a specialized data scientist and analyst. Use mounted AGENTS.md instructions and skills, inspect real uploaded data before answering, and save final user-facing deliverables in ./outputs/.
AGENT_CONFIG_DIR=.agents

# File Upload Settings
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls,.parquet,.json,.jsonl

# Session Settings
SESSION_TIMEOUT_MINUTES=15
